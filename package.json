{
  "name": "solosocius",
  "private": true,
  "version": "0.2.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w apps/backend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "dev": "concurrently --kill-others --names BACKEND,FRONTEND --prefix \"[{name}]\" --prefix-colors cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "bump": "bash scripts/bump-version.sh",
    "bump:patch": "bash scripts/bump-version.sh patch",
    "bump:minor": "bash scripts/bump-version.sh minor",
    "bump:major": "bash scripts/bump-version.sh major"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
