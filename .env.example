#Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

#Backend
DATABASE_URL=${POSTGRES_DATABASE_URL}
DOMAIN=social.example.com
PORT=4000
NODE_ENV=production

#Redis
REDIS_URL=redis://redis:6379

#Storage
STORAGE_PUBLIC_MEDIA_URL=https://social.example.com/media
S3_ENDPOINT=https://storage.example.com
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=youraccesskey
S3_SECRET_KEY=yoursecretkey

#Frontend
NEXT_PUBLIC_API_BASE=https://social.example.com/api