:80 {
    @wants_activity {
        header Accept *application/activity+json*
    }

    handle @wants_activity {
        reverse_proxy host.docker.internal:4000
    }

    handle /api/* {
        reverse_proxy host.docker.internal:4000
    }
    handle /outbox* {
        reverse_proxy host.docker.internal:4000
    }
    handle /inbox* {
        reverse_proxy host.docker.internal:4000
    }
    handle /.well-known/* {
        reverse_proxy host.docker.internal:4000
    }
    handle /actor* {
        reverse_proxy host.docker.internal:4000
    }

    handle /media/* {
        reverse_proxy backend:4000
    }

    handle {
        reverse_proxy host.docker.internal:3000
    }
}